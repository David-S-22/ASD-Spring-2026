{% for anomaly in anomalies %}
{% set txn = transactions.get(anomaly.transaction_id) %}
<tr>
  <td>{{ anomaly.id }}</td>
  <td>{{ txn.date.strftime('%Y-%m-%d') if txn else '—' }}</td>
  <td>{{ (txn.merchant if txn else '—')|e }}</td>
  <td>{{ anomaly.agent_reason_suspected|e }}</td>
  <td>{% if anomaly.is_confirmed_by_user is none %}<span class="status-badge status-unreviewed">Unreviewed</span>{% elif anomaly.is_confirmed_by_user %}<span class="status-badge status-accepted">Confirmed</span>{% else %}<span class="status-badge status-rejected">Dismissed</span>{% endif %}</td>
  <td>
    {% if anomaly.is_confirmed_by_user is none %}
    <button type="button"
            class="review-btn"
            data-anomaly-id="{{ anomaly.id }}"
            data-transaction-id="{{ (txn.id if txn else anomaly.transaction_id)|e }}"
            data-date="{{ (txn.date.isoformat() if txn else '—')|e }}"
            data-merchant="{{ (txn.merchant if txn else '—')|e }}"
            data-amount="{{ ('%.2f'|format(txn.amount) if txn else '—')|e }}"
            data-description="{{ (txn.description if txn else '—')|e }}"
            data-category-id="{{ (txn.category_id if txn else '—')|e }}"
            data-reason="{{ anomaly.agent_reason_suspected|e }}"
            onclick="openReviewModal(this)">
      Review
    </button>
    {% endif %}
  </td>
</tr>
{% else %}
<tr><td colspan="6" style="text-align: center;">No anomalies found.</td></tr>
{% endfor %}
