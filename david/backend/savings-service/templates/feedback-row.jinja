<tr data-id="{{ feedback.id }}">
    <td class="cell-id">{{ feedback.id }}</td>
    <td>{{ feedback.feedback }}</td>
    <td class="cell-suggestion">
        {% if feedback.suggestion_id %}
        <span class="badge badge-suggestion">#{{ feedback.suggestion_id }}</span>
        {% else %}
        <span class="badge badge-general">General</span>
        {% endif %}
    </td>
    <td class="cell-actions">
        <button type="button" 
                class="btn-edit" 
                hx-get="/savings-backend/feedback/{{ feedback.id }}/edit" 
                hx-target="closest tr" 
                hx-swap="outerHTML">Edit</button>
        <button type="button" 
                class="btn-delete" 
                hx-delete="/savings-backend/feedback/{{ feedback.id }}" 
                hx-target="#feedback" 
                hx-swap="innerHTML">Delete</button>
    </td>
</tr>
