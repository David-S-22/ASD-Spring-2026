<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Feedback</th>
            <th>Linked Suggestion</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for feedback in feedbacks %}
        {% include "feedback-row.jinja" %}
        {% else %}
        <tr>
            <td colspan="4">No current feedback.</td>
        </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr class="create-row">
            <td class="cell-id">+</td>
            <td><input type="text" name="feedback" placeholder="Feedback" required></td>
            <td class="cell-suggestion"><span class="badge badge-general">General</span></td>
            <td class="cell-actions">
                <button type="button" 
                        class="btn-create" 
                        hx-post="/savings-backend/feedback" 
                        hx-include="closest tr" 
                        hx-target="#feedback" 
                        hx-swap="innerHTML" 
                        hx-ext="json-enc">Create</button>
            </td>
        </tr>
    </tfoot>
</table>
