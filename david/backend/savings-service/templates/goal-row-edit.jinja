<tr data-id="{{ goal.id }}">
    <td class="cell-id">{{ goal.id }}</td>
    <td><input type="text" name="name" value="{{ goal.name }}" required></td>
    <td><input type="number" name="cost" value="{{ goal.cost }}" required></td>
    <td><input type="date" name="date" value="{{ goal.date.strftime('%Y-%m-%d') }}" required></td>
    <td class="cell-actions">
        <button type="button" 
                class="btn-accept" 
                title="Accept" 
                hx-patch="/savings/goal/{{ goal.id }}" 
                hx-include="closest tr" 
                hx-target="closest tr" 
                hx-swap="outerHTML" 
                hx-ext="json-enc">✓</button>
        <button type="button" 
                class="btn-cancel" 
                title="Cancel" 
                hx-get="/savings/goal/{{ goal.id }}" 
                hx-target="closest tr" 
                hx-swap="outerHTML">✗</button>
    </td>
</tr>

