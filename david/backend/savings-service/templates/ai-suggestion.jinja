<div class="dashboard-panel ai-suggestion-panel" id="ai-suggestion-container" {% if loading %}hx-get="/savings-backend/ai-suggestion" hx-trigger="load" hx-target="#ai-suggestion-container" hx-swap="outerHTML" {% endif %}hx-sync="this:replace">
    <div class="panel-header">
        <h2>AI Suggestion</h2>
        <button type="button" class="btn-refresh" 
                hx-get="/savings-backend/ai-suggestion" 
                hx-target="#ai-suggestion-container" 
                hx-indicator="#ai-suggestion-container" 
                hx-swap="outerHTML">
            Refresh
        </button>
    </div>
    <div class="ai-suggestion-body" id="ai-suggestion">
        <textarea class="ai-suggestion-textbox" name="suggestion" rows="3" readonly placeholder="Waiting for AI suggestion...">{{ "Waiting for AI suggestion..." if loading else (suggestion or "No current AI suggestion available.") }}</textarea>
        {% set is_valid = not loading and has_transactions and suggestion and not suggestion.startswith("Error") and not suggestion.startswith("You don't have") and suggestion != "No current AI suggestion available." %}
        <div class="ai-suggestion-feedback-section">
            <label for="ai-feedback-input">Feedback on this suggestion:</label>
            <textarea id="ai-feedback-input" class="ai-suggestion-feedback-input" 
                      name="feedback" rows="2" 
                      placeholder="{{ 'Explain why you are accepting or rejecting this suggestion...' if is_valid else 'Waiting for AI suggestion...' if loading else 'Feedback disabled: No valid suggestion available.' }}" 
                      {% if is_valid %}required{% else %}disabled readonly{% endif %}></textarea>
            <div class="ai-suggestion-actions">
                <button type="button" class="btn-accept" 
                        {% if is_valid %}
                        hx-post="/savings-backend/ai-suggestion/action?accepted=true" 
                        hx-include="closest #ai-suggestion-container" 
                        hx-target="#ai-suggestion-container" 
                        hx-indicator="#ai-suggestion-container" 
                        hx-swap="outerHTML"
                        {% else %}
                        disabled
                        {% endif %}>
                    ✓ Accept
                </button>
                <button type="button" class="btn-cancel" 
                        {% if is_valid %}
                        hx-post="/savings-backend/ai-suggestion/action?accepted=false" 
                        hx-include="closest #ai-suggestion-container" 
                        hx-target="#ai-suggestion-container" 
                        hx-indicator="#ai-suggestion-container" 
                        hx-swap="outerHTML"
                        {% else %}
                        disabled
                        {% endif %}>
                    ✗ Reject
                </button>
            </div>
        </div>
    </div>
</div>
