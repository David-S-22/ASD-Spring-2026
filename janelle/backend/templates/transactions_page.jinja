<section id="transactions-content" class="panel">
    <div class="transactions-toolbar">
        <div>
            <h1>Transactions</h1>
            <p>Review the transactions you have entered.</p>
        </div>
        <button id="add-transaction-button"
                type="button"
                hx-get="/transactions-backend/ui/transactions/new"
                hx-target="#transactions-content"
                hx-swap="outerHTML">
            + Add transaction
        </button>
    </div>

    {% if notice %}
    <p class="transaction-notice" role="status">{{ notice }}</p>
    {% endif %}

    <div id="transactions-table"
         hx-get="/transactions-backend/ui/transactions?page=1&amp;page_size=5"
         hx-trigger="load, transactionsChanged from:body"
         hx-swap="outerHTML">
        <div class="transactions-table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Merchant</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody id="transactions">
                    <tr><td colspan="5">Loading...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div id="transaction-chat-panel"
         class="transaction-chat-panel"
         hx-get="/transactions-backend/ui/chat"
         hx-trigger="load"
         hx-swap="outerHTML">
        <p class="transaction-chat-status">Loading Ask Tally...</p>
    </div>
</section>
